# FOC Observer deployment configuration
# Copy to .env and fill in values. See README.md "Security model" before exposing a deployment.

# Public URL of this foc-observer deployment (used in agent context for examples)
FOC_API_URL=https://your-deployment.example.com

# Server port
FOC_SERVER_PORT=17824

# Host address Compose publishes the server on (default 127.0.0.1, for a reverse
# proxy on this host). For a proxy on another machine, use its specific interface
# address and firewall the port so only that proxy can reach it.
# FOC_SERVER_BIND=127.0.0.1

# Generate separate secrets, for example with `openssl rand -hex 32`. Compose
# passes passwords through PGPASSWORD rather than database URLs, so URL encoding
# is not needed. Empty values and matching owner/query values stop provisioning.
FOC_DATABASE_OWNER_PASSWORD=
FOC_QUERY_DATABASE_PASSWORD=

# To rotate the owner password on populated volumes, set the current password
# here and the replacement above. Unset this after both databases accept the
# replacement. Leave it unset for fresh volumes.
# FOC_DATABASE_OWNER_PREVIOUS_PASSWORD=

# Lotus RPC endpoints. Compose passes each URL to a separate indexer and
# selects its network with PONDER_NETWORK; no network-specific image is needed.
# For remote RPC:
#   CALIBNET_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
#   MAINNET_RPC_URL=https://api.node.glif.io/rpc/v1
CALIBNET_RPC_URL=
MAINNET_RPC_URL=

# Optional local Lotus proxy. It only accepts traffic on the Docker bridge
# gateway, then forwards to loopback-only Lotus ports. Set LOTUS_PROXY_BIND to
# the gateway address used by host.docker.internal; keep the profile enabled
# for ordinary restarts as well as the first `docker compose up -d`.
# COMPOSE_PROFILES=lotus
# CALIBNET_RPC_URL=http://host.docker.internal:11235/rpc/v1
# MAINNET_RPC_URL=http://host.docker.internal:11234/rpc/v1
# LOTUS_PROXY_BIND=172.17.0.1
# LOTUS_MAINNET_PORT=2234
# LOTUS_CALIBNET_PORT=2235

# BetterStack ClickHouse credentials (enables DealBot deal/retrieval metrics)
BETTERSTACK_CH_USER=
BETTERSTACK_CH_PASSWORD=

# Active Ponder data schema per network (optional, default data_v1).
# Deployment state, not code: bump on reindex cutover (see AGENTS.md
# "Re-indexing"). Fresh deploys can leave these unset.
# CALIBNET_DATA_SCHEMA=data_v1
# MAINNET_DATA_SCHEMA=data_v1
